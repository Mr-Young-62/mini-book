# ==============================================================================
# MEELIEFONT MINI DIGITAL LIBRARY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase API URL and Publishable / Anon Key
# Provide these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"

# APP_URL: Cloud Run / Hosting service URL
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# BUILD-TIME RELEASE IDENTITY (optional, non-secret)
# CI injects these automatically on tagged releases (android-release.yml) so the
# web bundle knows its own version. Leave unset for local dev: the in-app update
# checker stays disabled when VITE_APP_VERSION_CODE is absent (value 0).
# versionCode scheme: MAJOR*1000000 + MINOR*1000 + PATCH (e.g. 1.2.3 -> 1002003).
# ------------------------------------------------------------------------------
# VITE_APP_VERSION="1.2.3"
# VITE_APP_VERSION_CODE="1002003"
# VITE_UPDATE_MANIFEST_URL="https://storage.googleapis.com/your-bucket/latest.json"

# ------------------------------------------------------------------------------
# WEB PUSH (Tahap G — iOS PWA / browser notifications). NON-SECRET.
# VAPID public key pairs with VAPID_PRIVATE_KEY (server-side only). Generate with:
#   npx web-push generate-vapid-keys
# Put the public value in Vercel/CI as VITE_VAPID_PUBLIC_KEY (build-time).
# ------------------------------------------------------------------------------
# VITE_VAPID_PUBLIC_KEY="BDLi3jEX..."

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (do NOT add the VITE_ prefix)
# Set these with `npx supabase secrets set NAME=value` for Edge Functions.
# ------------------------------------------------------------------------------
# GOOGLE_BOOKS_API_KEY used by the book-metadata Edge Function.
# UPDATE_PUSH_SECRET: shared secret GitHub Actions sends to send-update-push.
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: Web Push signing pair (same values as
#   VITE_VAPID_PUBLIC_KEY public half). VAPID_SUBJECT optional (mailto: or https:).
