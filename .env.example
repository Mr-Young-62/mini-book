# ==============================================================================
# READOWL MINI DIGITAL LIBRARY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase API URL and Publishable / Anon Key
# Provide these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"

# Optional: Google Books API key for higher rate limits on fallback metadata
# (Can also be set in Supabase Edge Function secrets)
VITE_GOOGLE_BOOKS_API_KEY=""

# Gemini AI API Key (Auto-injected by AI Studio if available)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Hosting service URL
APP_URL="MY_APP_URL"
